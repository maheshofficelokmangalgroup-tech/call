# Where the FastAPI backend lives, as seen from the admin server (not from the browser).
#   local development:  http://127.0.0.1:8000
#   docker compose:     http://api:8000
BACKEND_URL=http://127.0.0.1:8000

# Set to "true" when the panel is served over HTTPS (production). It makes the session cookies "Secure".
COOKIE_SECURE=false

# Public name shown in the panel header and the browser tab.
NEXT_PUBLIC_APP_NAME=Employee Calling

# Where employees download the mobile app; added to the login message sent on WhatsApp (leave empty to leave it out).
NEXT_PUBLIC_APP_DOWNLOAD_URL=
