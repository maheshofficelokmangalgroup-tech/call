# Copy to .env and fill in. NEVER commit the real .env file.
# Used by docker-compose.yml and by the backend when run locally.

APP_ENV=local                 # local | development | staging | production
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata     # business timezone used for "today" in dashboards and queues
DEFAULT_PHONE_REGION=IN
LOG_LEVEL=INFO

# ---- database (MySQL 8 in Docker / RDS). For a zero-install dev run use: sqlite:///./var/dev.db
MYSQL_DATABASE=calling_app
MYSQL_USER=app
MYSQL_PASSWORD=<dev-secret>
MYSQL_ROOT_PASSWORD=<dev-root-secret>
DATABASE_URL=mysql+pymysql://app:<dev-secret>@mysql:3306/calling_app?charset=utf8mb4

# ---- redis (optional in dev: the API falls back to in-memory if unreachable)
REDIS_URL=redis://redis:6379/0

# ---- auth: generate with  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<local-secret-at-least-32-chars>
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# ---- storage for recordings: local folder in dev, private S3 bucket in production
STORAGE_BACKEND=local         # local | s3
AWS_REGION=ap-south-1
AWS_S3_BUCKET=<production-bucket>
AWS_ACCESS_KEY_ID=<only if required - prefer an IAM role on EC2>
AWS_SECRET_ACCESS_KEY=<only if required - prefer an IAM role on EC2>

# ---- web / mobile
ADMIN_WEB_ORIGIN=http://localhost:3000
MOBILE_API_BASE_URL=http://<developer-machine-ip>:8000

# ---- first administrator, created by `python -m scripts.bootstrap` when no admin exists yet
BOOTSTRAP_ADMIN_EMAIL=admin@company.com
BOOTSTRAP_ADMIN_PASSWORD=<choose-a-strong-password>
