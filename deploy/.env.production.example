# Settings of the production stack (docker-compose.prod.yml). `deploy/install.sh` creates the real file for you, with
# fresh random secrets, as  .env.production  next to docker-compose.prod.yml.  NEVER commit .env.production.

# ---- where the panel and the API are reachable --------------------------------------------------------------------
# A domain name that points at this server, e.g. calling.example.com. Caddy then gets the HTTPS certificate by itself.
# For a server inside the office network with no domain use ":80" (plain http; phones must be on the same network).
SITE_ADDRESS=calling.example.com
# the same address as people type it, with http:// or https://
PUBLIC_URL=https://calling.example.com
# true when SITE_ADDRESS is a domain (HTTPS); false for ":80"
COOKIE_SECURE=true
# e-mail for the certificate (Let's Encrypt writes here when it is about to expire)
ACME_EMAIL=admin@example.com
# name shown in the panel (compiled into the image)
APP_NAME=Employee Calling
# where employees download the app; the panel adds it to the login message it sends on WhatsApp (compiled into the image)
APP_DOWNLOAD_URL=https://github.com/<owner>/<repo>/releases/latest/download/EmployeeCalling.apk

# ---- the database -------------------------------------------------------------------------------------------------
MYSQL_DATABASE=calling_app
MYSQL_USER=app
MYSQL_PASSWORD=<generated>
MYSQL_ROOT_PASSWORD=<generated>
# 256M is right for a 2 GB server; raise it on bigger machines
MYSQL_BUFFER_POOL=256M

# ---- the API ------------------------------------------------------------------------------------------------------
APP_TIMEZONE=Asia/Kolkata
DEFAULT_PHONE_REGION=IN
LOG_LEVEL=INFO
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<generated>
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# where call recordings are kept: "local" (a Docker volume on this server, included in the backups) or "s3"
STORAGE_BACKEND=local
#AWS_REGION=ap-south-1
#AWS_S3_BUCKET=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
MAX_RECORDING_MB=100

# ---- the first administrator ----------------------------------------------------------------------------------------
# Created at the first start when there is no administrator yet. install.sh prints the password once and then removes it
# from this file.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=<generated>

# ---- prebuilt images (optional) -------------------------------------------------------------------------------------
# Leave empty to build the images on this server (needs about 2 GB of free memory while building). To use the images that
# GitHub builds for every release, set both, e.g.
#   ADMIN_IMAGE=ghcr.io/<owner>/<repo>/admin:latest
#   API_IMAGE=ghcr.io/<owner>/<repo>/api:latest
ADMIN_IMAGE=
API_IMAGE=
