<?xml version="1.0" encoding="utf-8"?>
<!--
  The rule of a build that talks to a server on the internet (its address starts with https://): nothing travels in plain text,
  not even by a redirect. A build for a pilot server on the office network (an address starting with http://) uses
  network_security_config_pilot.xml instead; app/build.gradle picks the one that fits the address given to the build.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
