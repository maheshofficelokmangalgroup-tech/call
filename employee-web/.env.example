# Settings of the employee web app's container (docker-compose.yml). Copy this file to  .env  and edit it. NEVER commit .env.

# Where the API is, as seen from the container, WITHOUT a trailing slash.
#   the API on another server / its public address:  https://calling.example.com
#   the API in the same Docker network:               http://api:8000
API_UPSTREAM=https://calling.example.com

# Where the web app is reachable.
#   ":80"            plain http (an office network, or behind another front door). Employees open  http://<this server>:<HTTP_PORT>
#   "app.example.com" a domain name that points at this server: HTTPS is set up by itself (ports 80 and 443 must be free)
SITE_ADDRESS=:80

# Ports on this server (leave 80 / 443 for a domain)
HTTP_PORT=8080
HTTPS_PORT=8443

# e-mail for the HTTPS certificate (only used with a domain)
ACME_EMAIL=admin@example.com

# shown on the Profile page
APP_VERSION=1.0.0
