# Settings of the shared-server deployment (deploy/shared/docker-compose.yml).
# `setup.sh` creates the real file (.env, readable by its owner only) with fresh secrets. NEVER commit .env.

# ---- where it is reachable ----------------------------------------------------------------------------------------
# a hostname that points at this server. Without a domain use  <ip with dashes>.sslip.io  (13-205-79-72.sslip.io): it resolves
# to the IP by itself and Let's Encrypt gives it a free certificate.
PUBLIC_HOST=13-205-79-72.sslip.io
# the one public port of this project (open it in the server's firewall / security group)
HTTPS_PORT=8445
PUBLIC_URL=https://13-205-79-72.sslip.io:8445
# Let's Encrypt writes here when the certificate is about to expire
ACME_EMAIL=you@example.com
# the Docker volume that the server's existing nginx serves /.well-known/acme-challenge/ from (certbot "webroot")
CERTBOT_WEBROOT_VOLUME=app_certbot_webroot

# ---- the images (built by GitHub Actions, see .github/workflows/deploy.yml) -----------------------------------------
API_IMAGE=ghcr.io/<owner>/<repo>/api
ADMIN_IMAGE=ghcr.io/<owner>/<repo>/admin
IMAGE_TAG=latest

# ---- the database on RDS --------------------------------------------------------------------------------------------
# a user that can reach ONLY its own database (create it with create-database-user.sh)
DATABASE_URL=mysql+pymysql://calling_app:<generated>@<rds-endpoint>:3306/Calling_db?charset=utf8mb4&ssl_ca=/certs/rds-ca.pem

# ---- the API ----------------------------------------------------------------------------------------------------------
APP_TIMEZONE=Asia/Kolkata
DEFAULT_PHONE_REGION=IN
LOG_LEVEL=INFO
JWT_SECRET=<generated>
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
STORAGE_BACKEND=local
MAX_RECORDING_MB=100

# ---- the first administrator (created at the first start when there is none; the password is removed from this file afterwards)
BOOTSTRAP_ADMIN_EMAIL=you@example.com
BOOTSTRAP_ADMIN_PASSWORD=<generated>
