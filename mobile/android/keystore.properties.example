# Copy to keystore.properties (git-ignored) and point it at your release keystore:
#   keytool -genkeypair -v -keystore app/release.keystore -alias employeecalling -keyalg RSA -keysize 2048 -validity 12000
storeFile=app/release.keystore
storePassword=CHANGE_ME
keyAlias=employeecalling
keyPassword=CHANGE_ME
